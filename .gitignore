# Dependencies — NEVER commit these
node_modules/
**/node_modules/

# Build output
dist/
build/
*.local

# Environment files — NEVER commit secrets
.env
.env.local
.env.production.local
.env.development.local
.env.test.local
# Note: .env.production and .env.example ARE safe to commit (no secrets)

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
